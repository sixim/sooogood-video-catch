    "视频解析与下载": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videoanalyse und Download"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video Analysis and Download"
          }
        },
        "fr": {
          "stringUnit": {
