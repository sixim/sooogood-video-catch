    "使用 %@ 登录窗口中的会话；若解析提示需要登录，请重新打开登录窗口。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet die Sitzung aus dem %@-Anmeldefenster. Meldet die Analyse, dass eine Anmeldung nötig ist, öffne das Anmeldefenster erneut."
          }
        },
        "en": {
          "stringUnit": {
