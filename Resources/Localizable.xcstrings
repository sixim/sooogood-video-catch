    "%@ 必须是字符串": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muss ein String sein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ must be a string"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doit être une chaîne"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は文字列である必要があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 문자열이어야 합니다"
          }
        }
      }
    },
    "%@ 必须是非空字符串数组": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muss ein nicht leeres String-Array sein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ must be a non-empty array of strings"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doit être un tableau de chaînes non vide"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は空でない文字列配列である必要があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 비어 있지 않은 문자열 배열이어야 합니다"
          }
        }
      }
    },
    "%@ 没有权限读取 Safari 登录状态。推荐改用已登录 Vimeo 的 Chrome；或者在“系统设置 → 隐私与安全性 → 完整磁盘访问”中加入并启用 %@，然后退出并重新打开应用。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ darf den Safari-Anmeldestatus nicht lesen. Wir empfehlen stattdessen Chrome mit Vimeo-Anmeldung, oder füge %@ unter „Systemeinstellungen → Datenschutz & Sicherheit → Festplattenvollzugriff“ hinzu, aktiviere es und öffne die App neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not allowed to read Safari's sign-in state. We recommend Chrome signed in to Vimeo instead, or add and enable %@ under “System Settings → Privacy & Security → Full Disk Access”, then quit and reopen the app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas autorisé à lire l’état de connexion de Safari. Nous recommandons plutôt Chrome connecté à Vimeo, ou ajoutez et activez %@ dans « Réglages Système → Confidentialité et sécurité → Accès complet au disque », puis quittez et rouvrez l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ には Safari のログイン状態を読む権限がありません。Vimeo にログイン済みの Chrome の使用をおすすめします。または「システム設定 → プライバシーとセキュリティ → フルディスクアクセス」で %@ を追加して有効にし、アプリを終了して再度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 Safari 로그인 상태를 읽을 권한이 없습니다. Vimeo에 로그인한 Chrome 사용을 권장합니다. 또는 '시스템 설정 → 개인정보 보호 및 보안 → 전체 디스크 접근 권한'에서 %@을(를) 추가해 켠 뒤 앱을 종료하고 다시 여세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ 没有权限读取 Safari 登录状态。推荐改用已登录 Vimeo 的 Chrome；或者在“系统设置 → 隐私与安全性 → 完整磁盘访问”中加入并启用 %2$@，然后退出并重新打开应用。"
          }
        }
      }
    },
