          }
        }
      }
    },
    "音乐页面仍可使用 Spotify 曲目顺序整理你拥有的本地音频，并生成可复核的素材包。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seite „Musik“ kann dein eigenes lokales Audio weiterhin in Spotifys Titelreihenfolge ordnen und prüfbare Pakete erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Music page can still organize your own local audio in Spotify's track order and create verifiable packages."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page Musique peut toujours organiser votre audio local dans l’ordre des titres Spotify et créer des paquets vérifiables."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽ページでは引き続き、Spotify の曲順であなたのローカル音声を整理し、検証可能なパッケージを作成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악 페이지에서는 여전히 Spotify 곡 순서로 내가 가진 로컬 오디오를 정리하고 검증 가능한 패키지를 만들 수 있습니다."
          }
        }
      }
    },
    "音质": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualität"
          }
        },
        "en": {
