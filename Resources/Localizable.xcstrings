    "在 %@ 内打开官网登录，分别保存各网站会话": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich in %@ auf den offiziellen Websites an; jede Sitzung wird getrennt gespeichert"
          }
        },
        "en": {
