    "%@ 不是有效的 http(s) 链接": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist kein gültiger http(s)-Link"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not a valid http(s) link"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas un lien http(s) valide"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は有効な http(s) リンクではありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 유효한 http(s) 링크가 아닙니다"
          }
        }
      }
    },
    "%@ 中没有有效链接": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine gültigen Links in %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No valid links in %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun lien valide dans %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に有効なリンクがありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 유효한 링크가 없습니다"
          }
        }
      }
    },
    "%@ 使用受保护媒体流": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwendet geschützte Medienstreams"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uses protected media streams"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ utilise des flux protégés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は保護されたメディアストリームを使用しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 보호된 미디어 스트림을 사용합니다"
          }
        }
      }
    },
    "%@ 只读取曲目、专辑和歌单信息。音频仍来自你选择的本地资料夹或明确授权的 DRM-free 直链。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ liest nur Titel-, Album- und Playlist-Informationen. Audio stammt weiterhin aus lokalen Ordnern, die du wählst, oder aus DRM-freien Links, die du nutzen darfst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ only reads track, album and playlist information. Audio still comes from local folders you choose or DRM-free links you are authorized to use."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lit uniquement les informations de titres, d’albums et de playlists. L’audio provient toujours de dossiers locaux que vous choisissez ou de liens sans DRM que vous êtes autorisé à utiliser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は曲・アルバム・プレイリストの情報だけを読み取ります。音声は引き続き、あなたが選んだローカルフォルダか、利用を許可された DRM フリーのリンクから取得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 곡, 앨범, 재생목록 정보만 읽습니다. 오디오는 여전히 직접 선택한 로컬 폴더나 사용이 허가된 DRM-free 링크에서 가져옵니다."
          }
        }
      }
    },
    "%@ 只载入当前账号拥有或可协作的歌单%@。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lädt nur Playlists, die diesem Konto gehören oder an denen es mitarbeitet%@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ only loads playlists this account owns or collaborates on%@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ charge uniquement les playlists que ce compte possède ou auxquelles il collabore%@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はこのアカウントが所有または共同編集しているプレイリストだけを読み込みます%@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 이 계정이 소유하거나 공동 작업 중인 재생목록만 불러옵니다%@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ 只载入当前账号拥有或可协作的歌单%2$@。"
          }
        }
      }
    },
    "%@ 封面": {
      "localizations": {
