        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez ici des fichiers vidéo ou audio, ou choisissez « Traiter… » sur un paquet terminé dans Téléchargements"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
