    },
    "请先在设置中填写 Spotify Developer App 的 Client ID。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib zuerst die Client ID deiner Spotify Developer App in den Einstellungen ein."
          }
