            "value": "Uses the session from the %@ sign-in window. If analysis says sign-in is needed, reopen the sign-in window."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise la session de la fenêtre de connexion %@. Si l’analyse indique qu’une connexion est requise, rouvrez la fenêtre de connexion."
          }
