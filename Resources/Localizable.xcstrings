          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le navigateur choisi est introuvable. Fermez cette fenêtre et choisissez un navigateur installé dans les réglages de connexion via le navigateur."
          }
        },
        "ja": {
          "stringUnit": {
