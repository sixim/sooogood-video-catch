          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解析が完了しました。キューに追加できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분석 완료, 대기열에 추가할 수 있습니다"
          }
        }
      }
    },
    "让 Claude Code、Hermes 等 agent 查询、加入、暂停任务，运行工具箱，发送到达芬奇；不提供任何删除操作": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass Agents wie Claude Code und Hermes Aufgaben abfragen, hinzufügen und pausieren, den Werkzeugkasten nutzen und an DaVinci Resolve senden; Löschvorgänge werden nicht angeboten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let agents like Claude Code and Hermes query, add and pause tasks, run the toolbox and send to DaVinci Resolve; no delete operations are offered"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permettez à des agents comme Claude Code et Hermes de consulter, ajouter et mettre en pause des tâches, d’utiliser la boîte à outils et d’envoyer vers DaVinci Resolve ; aucune suppression n’est proposée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code や Hermes などのエージェントがタスクの照会・追加・一時停止、ツールボックスの実行、DaVinci Resolve への送信を行えます。削除操作は提供しません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Hermes 같은 에이전트가 작업을 조회·추가·일시 정지하고, 도구 상자를 실행하고, DaVinci Resolve로 보낼 수 있습니다. 삭제 작업은 제공하지 않습니다"
          }
        }
      }
    },
    "设置": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen"
          }
        },
        "en": {
