    },
    "说明凭据、元数据、本地文件与可选浏览器登录状态如何处理": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie Zugangsdaten, Metadaten, lokale Dateien und die optionale Browser-Anmeldung verarbeitet werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How credentials, metadata, local files and optional browser sign-in are handled"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment sont traités les identifiants, les métadonnées, les fichiers locaux et la connexion facultative via le navigateur"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
