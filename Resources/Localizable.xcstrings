    "Vimeo 经常要求登录；私有或登录可见内容请启用浏览器登录状态。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vimeo verlangt oft eine Anmeldung; aktiviere die Browser-Anmeldung für private oder Mitgliederinhalte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vimeo often requires sign-in; enable browser sign-in for private or members-only content."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vimeo demande souvent une connexion ; activez la connexion via le navigateur pour les contenus privés ou réservés aux membres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vimeo はログインを求めることが多いです。非公開やログイン限定のコンテンツにはブラウザのログイン状態を有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
