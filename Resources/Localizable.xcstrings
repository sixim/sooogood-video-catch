    "把平台实际提供的最高质量媒体保存到本机": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere das hochwertigste Medium, das die Plattform tatsächlich bietet, auf diesem Mac"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the highest-quality media the platform actually provides to this Mac"
          }
        },
        "fr": {
