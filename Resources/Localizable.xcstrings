    "全部通过 Homebrew 安装与升级，应用不会自行下载可执行文件": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wird mit Homebrew installiert und aktualisiert; die App lädt nie selbst ausführbare Dateien"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is installed and upgraded with Homebrew; the app never downloads executables itself"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout s’installe et se met à jour avec Homebrew ; l’app ne télécharge jamais d’exécutables elle-même"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて Homebrew でインストール・更新します。アプリが実行ファイルを自らダウンロードすることはありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 Homebrew로 설치하고 업데이트합니다. 앱이 직접 실행 파일을 다운로드하지 않습니다"
          }
        }
      }
    },
    "关闭": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        },
        "en": {
          "stringUnit": {
