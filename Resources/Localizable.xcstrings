        }
      }
    },
    "Safari Cookie 受 macOS 保护，使用前可能需要为 %@ 开启完整磁盘访问。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari-Cookies sind durch macOS geschützt. Möglicherweise musst du %@ zuerst Festplattenvollzugriff gewähren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari cookies are protected by macOS. You may need to grant %@ Full Disk Access first."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cookies de Safari sont protégés par macOS. Vous devrez peut-être d’abord accorder l’accès complet au disque à %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari の Cookie は macOS で保護されています。使用前に %@ へのフルディスクアクセスの許可が必要な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari 쿠키는 macOS로 보호됩니다. 사용 전에 %@에 전체 디스크 접근 권한을 허용해야 할 수 있습니다."
          }
        }
      }
    },
