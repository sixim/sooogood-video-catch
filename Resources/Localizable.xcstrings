    "高画质、会员及地区限制内容可能需要登录。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hochwertige, Mitglieder- und regional beschränkte Inhalte können eine Anmeldung erfordern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High-quality, membership and region-restricted content may require sign-in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les contenus en haute qualité, réservés aux membres ou limités par région peuvent nécessiter une connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高画質、会員限定、地域制限のコンテンツにはログインが必要な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고화질, 회원 전용, 지역 제한 콘텐츠는 로그인이 필요할 수 있습니다."
          }
        }
      }
    },
    "高画质、番剧及账户可见内容可能需要登录。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hochwertige, Anime- und kontogebundene Inhalte können eine Anmeldung erfordern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High-quality, anime and account-only content may require sign-in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les contenus en haute qualité, animés ou réservés au compte peuvent nécessiter une connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高画質、アニメ、アカウント限定のコンテンツにはログインが必要な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
