          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The site has changed. Run brew upgrade yt-dlp in Terminal and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le site a changé. Exécutez brew upgrade yt-dlp dans le Terminal et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイトの構造が変わりました。ターミナルで brew upgrade yt-dlp を実行してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
