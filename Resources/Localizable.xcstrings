            "state": "translated",
            "value": "Connectez-vous sur les sites officiels dans %@ ; chaque session est conservée séparément"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 内で公式サイトにログインし、サイトごとにセッションを保存"
          }
